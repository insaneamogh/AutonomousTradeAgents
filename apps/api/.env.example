# ── API runtime ──────────────────────────────────────────────────────
ENV=local                              # local | staging | production
LOG_LEVEL=INFO
JWT_SECRET=change-me-locally-32-bytes-min
CORS_ORIGINS=*                         # explicit comma-list in production

# ── Storage ──────────────────────────────────────────────────────────
USE_POSTGRES=0                         # 1 = Postgres-backed stores (needs DATABASE_URL + `make migrate`)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autotrader

# ── Reconciler fleet (per-user, real broker) ─────────────────────────
RECONCILER_ENABLED=1
RECONCILER_INTERVAL_SECONDS=30
DRAWDOWN_HALT_THRESHOLD_PCT=-3.0

# ── Trading mode ─────────────────────────────────────────────────────
TRADING_MODE=paper                     # paper (default) | live
LIVE_TRADING_ENABLED=0                 # 1 + TRADING_MODE=live = real money. Deliberate, audited.
ALLOW_SHORTS=0                         # fail-closed default (unset/typo'd = off, per engine.env.env_flag —
                                        # only 1/true/yes/on arm it). 1 = arms shortable_check,
                                        # short_requires_stop, short_unbounded_loss_cap, and
                                        # short_gross_exposure_cap; still long-only without it.
ALLOW_OPTIONS=0                        # fail-closed default, same env_flag convention. 1 = arms the
                                        # whole options rule pipeline (Phase A: long calls/puts only);
                                        # still refuses every options order without it — options_disabled
                                        # fires first, before anything else runs.

# ── Broker: Alpaca ───────────────────────────────────────────────────
# Data keys (bars for features + ghost marks). Data-only keys work.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# OAuth app credentials (user connections)
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=autotrader://broker/callback
# Desktop/web "Connect Alpaca" lands here instead (browser can't open the
# native scheme above) — register BOTH as allowed redirect URIs on the
# Alpaca OAuth app. Must be a real, reachable HTTPS URL in staging/prod.
ALPACA_OAUTH_WEB_REDIRECT_URI=http://localhost:8000/api/v1/broker/connect/alpaca/redirect
# Token encryption at rest (32-byte base64; Doppler in prod)
BROKER_TOKEN_ENCRYPTION_KEY=

# ── Broker: Zerodha (DARK in v1 — India is v2 + SEBI review) ─────────
KITE_API_KEY=
KITE_API_SECRET=

# ── Agents / LLM ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                     # empty → deterministic MOCK council (dev/CI)
LLM_TEMPERATURE=0.0                    # council variance comes from the market, not the sampler
LLM_TIMEOUT_SECONDS=60
AGENTS_REQUIRE_REAL_LLM=0              # 1 = hard-fail instead of mock (SET IN PRODUCTION)
AGENTS_REQUIRE_REAL_DATA=0             # 1 = hard-fail instead of synthetic features (SET IN PRODUCTION)

# ── Market data: features ────────────────────────────────────────────
FRED_API_KEY=                          # free key — VIX / 10y / dollar for the Macro Analyst

# ── Observability: Langfuse (per-agent council tracing) ──────────────
# Both keys required to enable; absent → tracing is a hard no-op. Cloud
# default host shown; set to your self-hosted URL if applicable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com / self-hosted

# ── Email: magic-link delivery (prod login) ──────────────────────────
# Unset → no email; non-prod falls back to the dev-token deep-link. In
# production, configure a provider or users can't receive their login link.
EMAIL_PROVIDER=                            # 'resend' | 'smtp' | (empty = off)
EMAIL_FROM=                                # e.g. "Autonomous Trader <login@yourdomain.com>"
EMAIL_LINK_BASE=                           # optional https universal link; default is the app deep link
RESEND_API_KEY=                            # when EMAIL_PROVIDER=resend
# SMTP_HOST=                               # when EMAIL_PROVIDER=smtp
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Daily council cron ───────────────────────────────────────────────
AGENT_CRON_USER_ID=00000000-0000-0000-0000-000000000001
AGENT_CRON_WATCHLIST=SPY,QQQ,AAPL,NVDA,MSFT,GOOG,AMZN,META,TSLA,JPM
# AGENT_APPROVAL_TTL_MINUTES=          # unset → proposals live until ~market close (21:00 UTC)

# ── Council scheduler (apps/api/app/services/council/scheduler.py) ───
# Runs daily_cron inside the API process instead of a human tapping Run.
# Off by default in every env — it spends LLM budget the moment it's on.
COUNCIL_SCHEDULER_ENABLED=0            # 1 = arm the scheduler at all
COUNCIL_SCAN_TIMES_UTC=14:00           # comma-separated HH:MM baseline sweep time(s)
COUNCIL_BASELINE_ENABLED=1             # 1 = full-watchlist sweep at the times above
SCANNER_ENABLED=0                      # 1 = also arm the deterministic trigger loop
SCANNER_INTERVAL_MINUTES=5             # trigger-loop scan cadence
SCANNER_MAX_COUNCIL_RUNS=3             # per-scan cap on triggered council runs

# ── Scanner thresholds (packages/engine/engine/scanner/select.py) ────
# Only read when SCANNER_ENABLED=1. Every default below is the one
# select.py falls back to when the var is unset — uncomment to tune.
# SCANNER_BAR_MINUTES=15               # intraday bar size (free feed's ~15min embargo)
# SCANNER_COOLDOWN_MINUTES=240         # per-(symbol, rule) debounce
# SCANNER_VOLUME_SPIKE_MULT=2.0        # session volume ÷ 20-day average
# SCANNER_ATR_EXPANSION_MULT=1.5       # true range ÷ ATR-14
# SCANNER_GAP_PCT=2.0                  # open-vs-prior-close gap, percent
# SCANNER_ZSCORE_THRESHOLD=2.0         # |price z-score vs 20d mean| extreme
# SCANNER_DONCHIAN_BAND_PCT=10.0       # channel decile counted as "approaching the edge"

# ── Auth: Google Sign-In ("Continue with Google") ────────────────────
# Comma-separated OAuth client ids — Google issues a SEPARATE client id per
# platform (iOS/Android/Web) for one logical app, and the ID token's `aud`
# check accepts any of them. Unset → POST /api/v1/auth/google returns 503;
# magic-link login is completely unaffected either way.
GOOGLE_OAUTH_CLIENT_IDS=
# Fallback-exchange leg only (POST /auth/google/exchange) — needed ONLY if
# the configured Google OAuth client type is confidential ("Web
# application") and refuses a client-side PKCE exchange with no secret.
# Not needed for a public/native (iOS/Android) client type, which the
# mobile app exchanges directly with Google. Include the web client id in
# GOOGLE_OAUTH_CLIENT_IDS above too, so its resulting ID token passes aud.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Auth (dev) ───────────────────────────────────────────────────────
DEV_AUTH_BYPASS=0                      # 1 = fixture user without Bearer (dev only)
