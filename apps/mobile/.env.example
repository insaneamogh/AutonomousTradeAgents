# Mobile-side env. Copy to apps/mobile/.env (gitignored) for Expo dev.
#
# Vars prefixed with EXPO_PUBLIC_ are compiled into the bundle + readable
# at runtime via process.env. Anything not prefixed is dev-time only.

# Point the app at your API. Without this, src/lib/api.ts falls back to:
#   - Expo dev server's host (LAN IP) on a real device
#   - http://10.0.2.2:8000 (Android emulator) / localhost (iOS sim)
#
# For Railway:
EXPO_PUBLIC_API_URL=https://your-app.railway.app

# For local dev pointing at the host machine over LAN:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# "Continue with Google" — Google issues a SEPARATE OAuth client id per
# platform for one logical app; src/hooks/useGoogleSignIn.ts picks the
# right one for Platform.OS. These are client IDs, not secrets — safe to
# compile into the bundle (EXPO_PUBLIC_). Any platform left unset just
# disables the button on that platform (isConfigured: false) rather than
# breaking anything else. Matching client ids must also be listed in the
# API's GOOGLE_OAUTH_CLIENT_IDS (apps/api/.env.example) or the resulting
# ID token will fail the backend's aud check.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
